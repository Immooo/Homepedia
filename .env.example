# Application
APP_ENV=development
TZ=Europe/Paris
STREAMLIT_SERVER_PORT=8501
LOG_LEVEL=INFO

# Stockage local
DB_PATH=/app/data/homepedia.db
SQLITE_DB_PATH=/app/data/homepedia.db

# MongoDB (valeurs compatibles avec Docker Compose)
MONGO_URI=mongodb://mongo:27017
MONGO_DB=homepedia

# Collecte temps réel
POLL_INTERVAL_SECONDS=300
REALTIME_REQUEST_TIMEOUT_SECONDS=20
INSEE_SOURCE_URL=https://www.insee.fr/fr/statistiques/8669035

# Variables facultatives : renseignez-les uniquement dans votre .env local.
# DB_USER=
# DB_PASS=
# DB_HOST=
# DB_PORT=
# DB_NAME=
# KAGGLE_USERNAME=
# KAGGLE_KEY=
